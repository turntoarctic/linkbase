# ---- 数据库（必填）----
# PostgreSQL 18；本机开发可用 docker compose -f docker/compose.dev.yml up -d postgres
DATABASE_URL=postgres://linkbase:linkbase@localhost:5432/linkbase

# ---- 会话签名（必填，>=16 字符）----
JWT_SECRET=dev-only-secret-change-me-please

# ---- Redis（可选：会话/邀请/限流；缺省用进程内存降级，仅开发）----
# REDIS_URL=redis://localhost:6379

# ---- 服务 ----
PORT=3001
FRONTEND_URL=http://localhost:5173
# 前端静态产物目录（生产同进程托管，相对仓库根）
WEB_DIST=apps/web/dist

# ---- 开关 ----
# 限流（登录 5/min、注册 3/h、全局 100/15min）
RATE_LIMIT_ENABLED=1
LOG_LEVEL=info
